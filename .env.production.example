# Vercel Production Environment Variables
# Add these in Vercel Project Settings -> Environment Variables
# Scope: Production, Preview, Development

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=campusvoice
NEXT_PUBLIC_APPWRITE_FUNCTION_ID=campusvoice-api
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app

# NOTE: Do NOT add APPWRITE_API_KEY to Vercel. 
# Server secrets belong exclusively in Appwrite Cloud Function settings.
