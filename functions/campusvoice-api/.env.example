# Appwrite Cloud Function Environment Variables
# Configure in Appwrite Console > Functions > campusvoice-api > Settings > Variables

APPWRITE_FUNCTION_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_FUNCTION_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_server_api_key_with_databases_and_users_scope

# Database & Collection IDs
APPWRITE_DATABASE_ID=campusvoice
COLLECTION_PROFILES=profiles
COLLECTION_DEPARTMENTS=departments
COLLECTION_COMPLAINTS=complaints
COLLECTION_SUPPORTS=complaint_supports

# Department Administrator Email Allowlist (Normalized lowercase)
ADMIN_ALLOWLIST_06=admin.civil@college.edu
ADMIN_ALLOWLIST_07=admin.computer@college.edu

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://campusvoice.vercel.app
