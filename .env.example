# ==============================================================================
# CampusVoice — Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client Configuration (Next.js App Router — Public / Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6ad8e59a00154ed97543
NEXT_PUBLIC_APPWRITE_DATABASE_ID=campusvoice
# 20-character Appwrite Cloud Function ID for the campusvoice-api router
NEXT_PUBLIC_APPWRITE_FUNCTION_ID=6ada7151003399e4bab7
# Private storage bucket ID for complaint attachments (PDF/JPG/JPEG/PNG <= 5MB)
NEXT_PUBLIC_APPWRITE_ATTACHMENTS_BUCKET_ID=complaint-attachments
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Server & Provisioning Configuration (Cloud Functions & Setup Scripts)
# ------------------------------------------------------------------------------
# Secret Server API Key with Database, Storage, Users, and Functions scopes
APPWRITE_API_KEY=your_secret_api_key_here
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ad8e59a00154ed97543
APPWRITE_DATABASE_ID=campusvoice
APPWRITE_STORAGE_BUCKET_ID=complaint-attachments

# Optional Appwrite Function runtime overrides (injected automatically in Appwrite Cloud)
# APPWRITE_FUNCTION_ENDPOINT=https://fra.cloud.appwrite.io/v1
# APPWRITE_FUNCTION_PROJECT_ID=6ad8e59a00154ed97543
# APPWRITE_FUNCTION_API_KEY=

# ------------------------------------------------------------------------------
# 3. Appwrite Database Collections Configuration
# ------------------------------------------------------------------------------
COLLECTION_PROFILES=profiles
COLLECTION_DEPARTMENTS=departments
COLLECTION_COMPLAINTS=complaints
COLLECTION_SUPPORTS=complaint_supports
COLLECTION_TIMELINE=complaint_timeline
COLLECTION_DEPARTMENT_ADMINS=department_admins
COLLECTION_PHONE_CHANGE_REQUESTS=phone_change_requests
COLLECTION_WARNINGS=complaint_warnings
COLLECTION_AUDIT_LOGS=audit_logs

# ------------------------------------------------------------------------------
# 4. Legacy / Fallback Admin Email Allowlists (Optional / Testing)
# Primary admin authorization is dynamically managed via the department_admins
# collection and Principal profiles. These are legacy test/fallback allowlists.
# ------------------------------------------------------------------------------
ADMIN_ALLOWLIST_06=civil.admin@college.edu
ADMIN_ALLOWLIST_07=computer.admin@college.edu
